# ===============================================
# Maven (Reglas de construcción y artefactos)
# ===============================================

# Directorio de construcción principal de Maven
target/

# Archivos temporales comunes de Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
dependency-reduced-pom.xml
buildnumber.properties
.mvn/timing.properties

# Excepción para el JAR del Maven Wrapper (Se mantiene la que tenías)
!.mvn/wrapper/maven-wrapper.jar

# Excepciones de targets específicos dentro de src (Se mantienen las que tenías)
!**/src/main/**/target/
!**/src/test/**/target/

# ===============================================
# Lenguajes y Compilación
# ===============================================

# Archivos de caché/compilación de Kotlin
.kotlin

# ===============================================
# Entornos de Desarrollo Integrado (IDEs)
# ===============================================

### IntelliJ IDEA ###
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
*.iws
*.iml
*.ipr

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/

